SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/lendenclub_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=replace-with-db-username
DB_PASSWORD=replace-with-db-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password

BACKEND_AUTH_ENABLED=true
BACKEND_API_KEY=replace-with-a-long-random-api-key
BACKEND_AUTH_HEADER=X-API-Key

# Base64-encoded 32-byte AES key. Generate externally and keep it stable.
# PowerShell: $b = New-Object byte[] 32; $r = [Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
OTP_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

RISK_ENGINE_VERSION=1.0.0
RISK_RULES_VERSION=2026-08-28
AI_ENABLED=false
AI_PROVIDER=noop

# NPA import reads the same pfmp datasource used by the Selenium automation.
# Set NPA_IMPORT_ENABLED=true to sync automatically when the backend starts.
NPA_IMPORT_ENABLED=false
NPA_IMPORT_RUN_ON_STARTUP=true
NPA_SOURCE_DB_URL=jdbc:mysql://localhost:3306/pfmp?useSSL=false&serverTimezone=Asia/Kolkata
# NPA_SOURCE_DB_USERNAME=root
# NPA_SOURCE_DB_PASSWORD is optional. If omitted, DB_PASSWORD is reused.
# NPA_SOURCE_DB_PASSWORD=source-db-password
NPA_SOURCE_DB_DRIVER=com.mysql.cj.jdbc.Driver

OTP_MAX_RETRIES=5
OTP_RETRY_DELAY_MS=2000
