SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/lendenclub_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

BACKEND_AUTH_ENABLED=false
BACKEND_API_KEY=
BACKEND_AUTH_HEADER=X-API-Key

RISK_ENGINE_VERSION=1.0.0
RISK_RULES_VERSION=2026-08-28
AI_ENABLED=false
AI_PROVIDER=noop

# NPA import reads the same pfmp datasource used by the Selenium automation.
# Enable both flags to sync automatically when the backend starts.
NPA_IMPORT_ENABLED=false
NPA_IMPORT_RUN_ON_STARTUP=false
NPA_SOURCE_DB_URL=jdbc:mysql://localhost:3306/pfmp?useSSL=false&serverTimezone=Asia/Kolkata
NPA_SOURCE_DB_USERNAME=root
# Leave blank only if DB_PASSWORD is already the same password used by pfmp.
NPA_SOURCE_DB_PASSWORD=
NPA_SOURCE_DB_DRIVER=com.mysql.cj.jdbc.Driver

OTP_MAX_RETRIES=5
OTP_RETRY_DELAY_MS=2000

GMAIL_USERNAME=
GMAIL_PASSWORD=
