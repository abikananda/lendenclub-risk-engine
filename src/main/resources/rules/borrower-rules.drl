package com.abikananda.lendenclub.rules;

import com.abikananda.lendenclub.domain.BorrowerFact;
import com.abikananda.lendenclub.domain.EvaluationResult;
import com.abikananda.lendenclub.domain.LendingDecision;
import com.abikananda.lendenclub.domain.RiskLevel;
import java.math.BigDecimal;

global com.abikananda.lendenclub.domain.EvaluationResult evaluationResult;

dialect "java"

function boolean isDecisionNull(EvaluationResult result) {
    return result.getDecision() == null;
}

function boolean isLoanTooLargeForIncome(BigDecimal loanAmount, BigDecimal income) {
    return loanAmount.compareTo(income.multiply(new BigDecimal("0.50"))) > 0;
}

function boolean isEmiTooHigh(BigDecimal emi, BigDecimal income) {
    return emi.compareTo(income.multiply(new BigDecimal("0.20"))) > 0;
}

function boolean isRatioAtMost(BigDecimal numerator, BigDecimal denominator, BigDecimal maxRatio) {
    if (numerator == null || denominator == null || maxRatio == null || denominator.signum() <= 0) {
        return false;
    }
    return numerator.compareTo(denominator.multiply(maxRatio)) <= 0;
}

function boolean isMonthlyPaymentRatioAtMost(BigDecimal loanAmount, int tenure, BigDecimal income, BigDecimal maxRatio) {
    if (loanAmount == null || income == null || maxRatio == null || tenure <= 0 || income.signum() <= 0) {
        return false;
    }
    return loanAmount.compareTo(
            income.multiply(maxRatio).multiply(BigDecimal.valueOf(tenure))
    ) <= 0;
}

function boolean isMonthlyResidualAtLeast(BigDecimal loanAmount, int tenure, BigDecimal income, BigDecimal minResidual) {
    if (loanAmount == null || income == null || minResidual == null || tenure <= 0) {
        return false;
    }
    return income.multiply(BigDecimal.valueOf(tenure))
            .subtract(loanAmount)
            .compareTo(minResidual.multiply(BigDecimal.valueOf(tenure))) >= 0;
}

rule "Reject - Low Credit Score"
    salience 100
    when
        $b : BorrowerFact(creditScore < 550)
    then
        evaluationResult.setDecision(LendingDecision.REJECT);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Reject - Low Credit Score");
        evaluationResult.setRuleCode("REJ_CREDIT_SCORE");
        evaluationResult.setReason("Credit score is below minimum threshold of 550");
        evaluationResult.setInvestmentAmount(BigDecimal.ZERO);
end

rule "Reject - Loan Too Large For Income"
    salience 90
    when
        $b : BorrowerFact()
        eval(isLoanTooLargeForIncome($b.getLoanAmount(), $b.getIncome()))
    then
        evaluationResult.setDecision(LendingDecision.REJECT);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Reject - Loan Too Large For Income");
        evaluationResult.setRuleCode("REJ_LTI");
        evaluationResult.setReason("Loan amount exceeds 50% of monthly income");
        evaluationResult.setInvestmentAmount(BigDecimal.ZERO);
end

rule "Reject - EMI Too High"
    salience 80
    when
        $b : BorrowerFact()
        eval(isEmiTooHigh($b.getEmi(), $b.getIncome()))
    then
        evaluationResult.setDecision(LendingDecision.REJECT);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Reject - EMI Too High");
        evaluationResult.setRuleCode("REJ_FOIR");
        evaluationResult.setReason("EMI exceeds 20% of monthly income");
        evaluationResult.setInvestmentAmount(BigDecimal.ZERO);
end

/**********************************************************************
 * Investment rules below are synchronized from Selenium
 * src/main/resources/rules/premium-rules.drl.
 * Conditions and lending amounts intentionally match that source exactly.
 **********************************************************************/

rule "Repeated Lenders - Low Risk"
when
    $b : BorrowerFact(
        repeated == true,
        borrowerType == "SALARIED",
        creditScore >= 730,
        lendenScore >= 770,
        income >= new BigDecimal("80000"),
        interestRate >= new BigDecimal("18") && interestRate <= new BigDecimal("48"),
        age >= 25 && age <= 55,
        loanAmount <= new BigDecimal("30000"),
        tenure >= 1 && tenure <= 4,
        eval(isRatioAtMost(loanAmount, income, new BigDecimal("0.30"))),
        eval(isMonthlyPaymentRatioAtMost(loanAmount, tenure, income, new BigDecimal("0.20")))
    )
then
    evaluationResult.setDecision(LendingDecision.INVEST);
    evaluationResult.setRiskLevel(RiskLevel.LOW);
    evaluationResult.setRuleName("Repeated Lenders - Low Risk");
    evaluationResult.setRuleCode("REPEATED_LENDERS_LOW_RISK");
    evaluationResult.setReason("Matched Selenium rule: Repeated Lenders - Low Risk");
    evaluationResult.setInvestmentAmount(new BigDecimal("4000.00"));
end

