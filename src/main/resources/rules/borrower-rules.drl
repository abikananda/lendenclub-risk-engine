package com.abikananda.lendenclub.rules;

import com.abikananda.lendenclub.domain.BorrowerFact;
import com.abikananda.lendenclub.domain.EvaluationResult;
import com.abikananda.lendenclub.domain.LendingDecision;
import com.abikananda.lendenclub.domain.RiskLevel;
import java.math.BigDecimal;
import java.math.RoundingMode;

global com.abikananda.lendenclub.domain.EvaluationResult evaluationResult;

dialect "java"

function boolean isDecisionNull(EvaluationResult result) {
    return result.getDecision() == null;
}

function boolean isLoanTooLargeForIncome(BigDecimal loanAmount, BigDecimal income) {
    return loanAmount.compareTo(income.multiply(new BigDecimal("0.50"))) > 0;
}

function boolean isEmiTooHigh(BigDecimal emi, BigDecimal income) {
    return emi.compareTo(income.multiply(new BigDecimal("0.20"))) > 0;
}

function boolean isMonthlyPaymentAcceptable(BigDecimal loanAmount, int tenure, BigDecimal income) {
    BigDecimal monthlyPayment = loanAmount.divide(new BigDecimal(tenure), 2, RoundingMode.HALF_UP);
    return monthlyPayment.compareTo(income.multiply(new BigDecimal("0.30"))) <= 0;
}

rule "Reject - Low Credit Score"
    salience 100
    when
        $b : BorrowerFact(creditScore < 550)
    then
        evaluationResult.setDecision(LendingDecision.REJECT);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Reject - Low Credit Score");
        evaluationResult.setRuleCode("REJ_CREDIT_SCORE");
        evaluationResult.setReason("Credit score is below minimum threshold of 550");
        evaluationResult.setInvestmentAmount(BigDecimal.ZERO);
end

rule "Reject - Loan Too Large For Income"
    salience 90
    when
        $b : BorrowerFact()
        eval(isLoanTooLargeForIncome($b.getLoanAmount(), $b.getIncome()))
    then
        evaluationResult.setDecision(LendingDecision.REJECT);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Reject - Loan Too Large For Income");
        evaluationResult.setRuleCode("REJ_LTI");
        evaluationResult.setReason("Loan amount exceeds 50% of monthly income");
        evaluationResult.setInvestmentAmount(BigDecimal.ZERO);
end

rule "Reject - EMI Too High"
    salience 80
    when
        $b : BorrowerFact()
        eval(isEmiTooHigh($b.getEmi(), $b.getIncome()))
    then
        evaluationResult.setDecision(LendingDecision.REJECT);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Reject - EMI Too High");
        evaluationResult.setRuleCode("REJ_FOIR");
        evaluationResult.setReason("EMI exceeds 20% of monthly income");
        evaluationResult.setInvestmentAmount(BigDecimal.ZERO);
end

rule "Repeated Lenders - High Risk"
    salience 50
    when
        $b : BorrowerFact(
            repeated == true,
            borrowerType == "SALARIED",
            creditScore >= 600,
            lendenScore >= 700,
            income >= new BigDecimal("25000"),
            interestRate >= new BigDecimal("18.0"),
            age >= 18 && age <= 60,
            loanAmount <= new BigDecimal("100000"),
            tenure >= 1 && tenure <= 12,
            eval((loanAmount * 1.0 / income) <= 0.50),
            eval((loanAmount * 1.0 / tenure) <= income * 0.40)
        )
    then
        evaluationResult.setDecision(LendingDecision.INVEST);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Repeated Lenders - High Risk");
        evaluationResult.setRuleCode("INV_REPEATED_SALARIED");
        evaluationResult.setReason("Meets criteria for high-risk repeated borrower");
        evaluationResult.setInvestmentAmount(new BigDecimal("1000.00"));
end

rule "Bulk Lenders"
    salience 40
    when
        $b : BorrowerFact(
            borrowerType == "SALARIED",
            creditScore >= 550,
            lendenScore >= 700,
            income >= new BigDecimal("25000"),
            interestRate >= new BigDecimal("18.0"),
            age >= 20 && age <= 60,
            loanAmount <= new BigDecimal("100000"),
            tenure >= 1 && tenure <= 12,
            eval((loanAmount * 1.0 / income) <= 0.90),
            eval((loanAmount * 1.0 / tenure) <= income * 0.50)
        )
    then
        evaluationResult.setDecision(LendingDecision.INVEST);
        evaluationResult.setRiskLevel(RiskLevel.HIGH);
        evaluationResult.setRuleName("Bulk Lenders");
        evaluationResult.setRuleCode("INV_BULK_SALARIED");
        evaluationResult.setReason("Meets criteria for bulk lender with acceptable risk");
        evaluationResult.setInvestmentAmount(new BigDecimal("250.00"));
end

rule "Default Skip Rule"
    salience 0
    when
        $b : BorrowerFact()
        eval(isDecisionNull(evaluationResult))
    then
        evaluationResult.setDecision(LendingDecision.SKIP);
        evaluationResult.setRiskLevel(RiskLevel.UNKNOWN);
        evaluationResult.setRuleName("Default Skip Rule");
        evaluationResult.setRuleCode("SKIP_DEFAULT");
        evaluationResult.setReason("No explicit investment rules triggered");
        evaluationResult.setInvestmentAmount(BigDecimal.ZERO);
end
